# === Decoupled AI Configuration ===
# AI Provider: 'gemini', 'openai', 'openai_compatible', 'ollama', 'groq', or 'mock'
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_API_KEY=your-api-key-here

# Optional: Base URL for OpenAI-compatible providers (Ollama, Groq, LocalAI)
# Example for local Ollama: http://localhost:11434/v1
# Example for Groq: https://api.groq.com/openai/v1
AI_BASE_URL=

# Legacy Gemini key fallback
GEMINI_API_KEY=

# === Scraping Behavior ===
SCRAPE_INTERVAL_HOURS=6
MAX_HEALING_ATTEMPTS=3
HTML_SAMPLE_MAX_CHARS=30000
DEFAULT_REQUEST_TIMEOUT=30
DEFAULT_CRAWL_DELAY=2.0

# === Observability ===
LOG_LEVEL=INFO
ALERT_WEBHOOK_URL=

# === Proxy ===
PROXY_URL=
